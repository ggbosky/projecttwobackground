{
  "name": "Project Two",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm run build && npm start",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Project Two",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
